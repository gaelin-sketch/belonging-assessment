{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "The Elmore Group Design System",
  "version": "1.0.0",
  "source": [
    "Be The Difference — keynote deck",
    "Belonging Assessment Leadership Report"
  ],
  "color": {
    "brand": {
      "navy":   { "value": "#122A42", "role": "Primary. Cover fields, headlines, dark bands." },
      "gold":   { "value": "#F2A516", "role": "Signature accent. Emphasis, ambiguity, at-risk." },
      "orange": { "value": "#EB4824", "role": "Alarm. Exclusion, critical, the \"what is\"." },
      "blue":   { "value": "#4F9CD6", "role": "Aspiration. Belonging, the \"what could be\"." },
      "green":  { "value": "#15694A", "role": "Growth. Section marks, positive movement." }
    },
    "navy":   { "900": "#0C1E30", "800": "#112941", "700": "#16314A", "600": "#1C3A57", "500": "#2A4A69", "wash": "#E6ECF3", "fill": "#CFDAE8" },
    "gold":   { "dark": "#9A6608", "deep": "#C9820A", "light": "#FFB92E", "wash": "#FDF1DC", "fill": "#FAE4B4" },
    "orange": { "dark": "#A82E13", "deep": "#C2371A", "light": "#FF9B7A", "wash": "#FDE9E3", "fill": "#F9D2C6" },
    "blue":   { "deep": "#2C6491", "dark": "#1F5FAD", "light": "#6FA5D2", "wash": "#E7EFF9", "fill": "#C9DEF2" },
    "green":  { "deep": "#0F4E37", "mid": "#34B27E", "wash": "#E3F5EC", "fill": "#C7EBDA" },
    "surface": {
      "paper":     { "value": "#FBFAF6", "role": "Page background. Cream, never white." },
      "paperSunk": { "value": "#F1ECE1", "role": "Recessed panels, table zebra." },
      "paperEdge": { "value": "#F6F5F1" },
      "card":      { "value": "#FFFFFF", "role": "Reserved for cards, so a card always lifts." },
      "field":     { "value": "#122A42", "role": "Full-bleed dark band." }
    },
    "ink": {
      "default":  "#16242F",
      "strong":   "#122A42",
      "soft":     "#5E6E79",
      "faint":    "#8A97A0",
      "ghost":    "rgba(18, 42, 66, 0.10)",
      "onField":     "#FFFFFF",
      "onFieldSoft": "#8FA3B8",
      "line":      "#E4DED1",
      "lineSoft":  "#EFEBE2",
      "lineField": "rgba(255, 255, 255, 0.14)"
    },
    "scales": {
      "relationalState": {
        "note": "Fixed order. Belonging first, then ambiguity, then exclusion.",
        "belonging": "#4F9CD6",
        "ambiguity": "#F2A516",
        "exclusion": "#EB4824"
      },
      "indexTier": {
        "note": "Four ordered tiers. Index 0-100, or an indicator 0-10.",
        "critical": { "value": "#EB4824", "index": "0-34",  "indicator": "0.0-3.4" },
        "atRisk":   { "value": "#F2A516", "index": "35-49", "indicator": "3.5-5.4" },
        "building": { "value": "#4F9CD6", "index": "50-64", "indicator": "5.5-7.4" },
        "strong":   { "value": "#2C6491", "index": "65+",   "indicator": "7.5-10" }
      },
      "findingTone": {
        "positive":    "#1F5FAD",
        "negative":    "#EB4824",
        "interesting": "#F2A516"
      },
      "section": {
        "note": "Divider pages rotate through these in order.",
        "1": "#122A42", "2": "#15694A", "3": "#9A6608", "4": "#2C6491", "5": "#A82E13"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "stack": "\"Figtree\", \"Archivo\", system-ui, -apple-system, sans-serif",
        "note": "The source files set display type in a licensed Gilroy-class geometric grotesque. Figtree is the closest freely-loadable stand-in and is what this system ships. Swap the first entry if the licensed face is available."
      },
      "body": { "stack": "\"IBM Plex Sans\", system-ui, -apple-system, sans-serif" },
      "mono": { "stack": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, monospace" }
    },
    "weight": { "regular": 400, "medium": 500, "semi": 600, "bold": 700, "black": 800 },
    "size": {
      "hero":    "clamp(44px, 7.5vw, 76px)",
      "display": "clamp(34px, 5.2vw, 52px)",
      "title":   "clamp(27px, 3.4vw, 36px)",
      "section": "24px",
      "sub":     "19px",
      "lead":    "17px",
      "body":    "15.5px",
      "small":   "13.5px",
      "micro":   "12px",
      "eyebrow": "11.5px",
      "figureXl": "clamp(56px, 9vw, 88px)",
      "figureL":  "44px",
      "figureM":  "28px",
      "figureS":  "20px"
    },
    "lineHeight": { "tight": 1.06, "snug": 1.18, "normal": 1.55, "loose": 1.65 },
    "letterSpacing": { "hero": "-0.02em", "title": "-0.015em", "normal": "0", "eyebrow": "0.16em", "label": "0.10em" }
  },
  "space": {
    "base": "4px",
    "scale": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px" },
    "pageMax": "1100px",
    "proseMax": "68ch",
    "gutter": "clamp(20px, 4vw, 44px)"
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "22px", "pill": "999px", "rail": "5px" },
  "shadow": {
    "card":  "0 1px 2px rgba(18,42,66,0.04), 0 10px 28px -16px rgba(18,42,66,0.22)",
    "lift":  "0 2px 4px rgba(18,42,66,0.05), 0 22px 48px -22px rgba(18,42,66,0.30)",
    "field": "0 20px 44px -24px rgba(0,0,0,0.55)"
  },
  "motion": {
    "ease": "cubic-bezier(0.2, 0, 0.2, 1)",
    "duration": { "fast": "120ms", "base": "200ms", "slow": "360ms" }
  }
}
